#!/usr/bin/env python3
"""vg - VPN query CLI for Duyao.VpnList (query-only).

Thin Python wrapper around `curl` for HTTP and `jq` for JSON shaping.
Reads subcommand + filters from argv, builds a curl invocation, and prints
compact JSON one entry per line so the output is pipeable to `vg jq`
(extracts `ip:port`).

Invocation:
    The script is intended to be invoked as `vg <subcommand> ...`, but you
    can also create symlinks (or copies) with the names below and invoke
    them directly — the basename of argv[0] is then treated as the
    subcommand, so `vgget Country` is equivalent to `vg get Country`.

    Allowed alias basenames (each maps to the shown subcommand):
        vgget  -> get     vgone  -> one     vgc   -> count
        vgiso  -> iso     vgjq   -> jq      vgv   -> version

    Subcommands:
        v|version                       GET  /vpn            show service version
        get  [country,...] [ip= S] [hn= S] [hx= S] [cx= S] [asn= S]
             [--page N --size N --all --all-cn]
                                        GET  /vpn/query     list entries
        one  [country,...] [ip= S ...]  GET  /vpn/rnd       pick one random entry
        c|count  [country,...]          GET  /vpn/query     print .total only
        asn  <substr>                   GET  /vpn/query     filter by asn_org
        ip   <substr>                   GET  /vpn/query     filter by ip
        hn   <substr>                   GET  /vpn/query     filter by host_name
        hx   <substr>                   GET  /vpn/query     exclude host_name
        iso  [--iso-all]                GET  /vpn/iso       list distinct countries
        post                             POST /vpn/query     send raw JSON body from stdin
        jq                               format stdin as ip:port (pipeable)
        help|-h|--help                  show this banner

    Note: when invoked as `vg` (the script's real name) with no recognised
    subcommand, the script now exits with an error — pass `get` explicitly
    (or use a `vgget` symlink) to query by country.

Filters:
    - Positional args are joined with ',' as country_contains (OR).
    - Each k=S flag sets one API filter. They are all optional and can be
      combined; matching is substring-based on the server.
        ip=S    matches ip_contains              (e.g. ip=10.0.)
        hn=S    matches host_name_contains       (e.g. hn=vpn.example)
        hx=S    matches host_name_not_contains   (e.g. hx=internal)
        cx=S    matches country_not_contains AND always also excludes
                "China" (regardless of --all-cn); repeat cx= multiple times
                to exclude several countries at once
                (e.g. cx=India cx=Russia)
        asn=S   matches asn_org_contains         (e.g. asn=Cloudflare)
    - By default China is excluded; pass --all-cn to include it.
    - --page N / --size N control pagination; --all walks every page.
    - --iso-all makes `iso` return is_valid=-1 (no validity filter).

Env:
    API_BASE   base URL (default https://sstp-https.1api.pp.ua/vpn)
"""
from __future__ import annotations

import os
import subprocess
import sys

API_BASE = os.environ.get("API_BASE", "https://sstp-https.1api.pp.ua/vpn")

BANNER = """\
vg - VPN query CLI for Duyao.VpnList (query-only)
Version - 2026.0803.1313
Invocation:
  vg <subcommand> [args...]              # canonical
  vgget, vgone, vgc, vgiso, vgjq, vgv    # symlink aliases (basename = subcommand)
  Any other `vg*` name is rejected.

Subcommands:
  v|version                       GET  /vpn            show service version
  get  [country,...] [ip=S] [hn=S] [hx=S] [cx=S] [asn=S]
       [--page N --size N --all --all-cn]
                                   GET  /vpn/query     list entries
  one  [country,...] [ip=S ...]    GET  /vpn/rnd       pick one random entry
  c|count  [country,...]           GET  /vpn/query     print .total only
  asn  <substr>                    GET  /vpn/query     filter by asn_org
  ip   <substr>                    GET  /vpn/query     filter by ip
  hn   <substr>                    GET  /vpn/query     filter by host_name
  hx   <substr>                    GET  /vpn/query     exclude host_name
  iso  [--iso-all]                 GET  /vpn/iso       list distinct countries
  post                              POST /vpn/query     send raw JSON body from stdin
  jq                                format stdin as ip:port (pipeable)
  help|-h|--help                   show this banner

Filters:
  - Positional args are joined with ',' as country_contains (OR).
  - Each k=S flag sets one API filter. They are all optional and can be
    combined; matching is substring-based on the server.
      ip=S    matches ip_contains              (e.g. ip=10.0.)
      hn=S    matches host_name_contains       (e.g. hn=vpn.example)
      hx=S    matches host_name_not_contains   (e.g. hx=internal)
      cx=S    matches country_not_contains AND always also excludes
              "China" (regardless of --all-cn); repeat cx= multiple times
              to exclude several countries at once
              (e.g. cx=India cx=Russia)
      asn=S   matches asn_org_contains         (e.g. asn=Cloudflare)
  - By default China is excluded; pass --all-cn to include it.
  - --page N / --size N control pagination; --all walks every page.
  - --iso-all makes `iso` return is_valid=-1 (no validity filter).

Env:
  API_BASE   base URL (default https://sstp-https.1api.pp.ua/vpn)

Version:
  - 2026.0803.1313
"""

SUBCOMMANDS = {
    "v", "version", "get", "one", "c", "count",
    "asn", "ip", "hn", "hx", "iso", "post", "jq",
    "help", "-h", "--help",
}

# Basename -> subcommand mapping for symlink-style invocations (e.g. `vgget`).
# Only the names below are accepted; any other `vg*` basename is an error.
ALIAS_BASENAMES = {
    "vgget": "get",
    "vgone": "one",
    "vgc":   "count",
    "vgiso": "iso",
    "vgjq":  "jq",
    "vgv":   "version",
}
# Canonical basenames (the script itself + explicit `vg` is allowed).
CANONICAL_BASENAMES = {"vg", "vg.py"}


# ----------------------- helpers -----------------------

def die(msg: str, code: int = 2) -> "None":
    print(f"vg: {msg}", file=sys.stderr)
    sys.exit(code)


def run_curl_get(path: str, params: list[tuple[str, str]]) -> str:
    """GET with --data-urlencode for each (k, v) pair, returning the body."""
    cmd = ["curl", "-4sL", "-G", f"{API_BASE}{path}"]
    for k, v in params:
        if v == "" or v is None:
            continue
        cmd += ["--data-urlencode", f"{k}={v}"]
    return _curl(cmd)


def run_curl_post(path: str, body: str) -> str:
    cmd = [
        "curl", "-4sL", "-X", "POST", f"{API_BASE}{path}",
        "-H", "Content-Type: application/json",
        "--data-binary", body,
    ]
    return _curl(cmd)


def _curl(cmd: list[str]) -> str:
    """Run curl, surfacing non-zero exits as a friendly vg error (no traceback)."""
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or "")
        die(f"curl failed (exit {proc.returncode})", code=proc.returncode or 1)
    return proc.stdout


# ----------------------- arg parsing -----------------------

def parse_filter_args_full(argv: list[str]):
    """Same as parse_filter_args but also returns the state dict."""
    filters: dict[str, str] = {}
    cx_user: list[str] = []
    positional: list[str] = []
    state = {
        "nc": "China",
        "page": 1,
        "size": 50,
        "walk_all": False,
        "iso_all": False,
    }
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            continue
        if a == "--all":
            state["walk_all"] = True
        elif a == "--all-cn":
            state["nc"] = ""
        elif a == "--not-cn":
            state["nc"] = "China"
        elif a == "--iso-all":
            state["iso_all"] = True
        elif a == "--page":
            i += 1
            if i >= len(argv):
                die("--page needs N")
            state["page"] = int(argv[i])
        elif a == "--size":
            i += 1
            if i >= len(argv):
                die("--size needs N")
            state["size"] = int(argv[i])
        elif a in ("-h", "--help", "help"):
            print(BANNER, end="")
            sys.exit(0)
        elif a.startswith("ip="):
            filters["ip_contains"] = a[3:]
        elif a.startswith("hn="):
            filters["host_name_contains"] = a[3:]
        elif a.startswith("hx="):
            filters["host_name_not_contains"] = a[3:]
        elif a.startswith("cx="):
            cx_user.append(a[3:])
        elif a.startswith("asn="):
            filters["asn_org_contains"] = a[4:]
        elif a.startswith("-"):
            die(f"unknown flag: {a}")
        else:
            positional.append(a)
        i += 1
    if cx_user:
        # cx= always implies excluding China too, regardless of --all-cn.
        seen: set[str] = set()
        out_parts: list[str] = []
        for part in (",".join(cx_user) + ",China").split(","):
            p = part.strip()
            if not p or p in seen:
                continue
            seen.add(p)
            out_parts.append(p)
        state["nc"] = ",".join(out_parts)
    return filters, positional, state


def _jq(expr: str, input_text: str) -> str:
    proc = subprocess.run(
        ["jq", "-r", expr],
        input=input_text,
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or "")
        die(f"jq failed (exit {proc.returncode})", code=proc.returncode or 1)
    return proc.stdout


def _jq_compact(expr: str, input_text: str) -> str:
    proc = subprocess.run(
        ["jq", "-c", expr],
        input=input_text,
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or "")
        die(f"jq failed (exit {proc.returncode})", code=proc.returncode or 1)
    return proc.stdout


# ----------------------- commands -----------------------

def cmd_query(filters: dict, positional: list[str], state: dict) -> None:
    countries = ",".join(positional) if positional else ""
    if countries:
        filters = {**filters, "country_contains": countries}
    if state["nc"]:
        filters = {**filters, "country_not_contains": state["nc"]}

    if state["walk_all"]:
        page = 1
        while True:
            params = [(k, v) for k, v in filters.items()]
            params += [("page", str(page)), ("size", str(state["size"]))]
            body = run_curl_get("/query", params)
            data_lines = _jq_compact(".data[]?", body)
            sys.stdout.write(data_lines)
            n = data_lines.count("\n")
            if n < state["size"]:
                break
            page += 1
            if page > 200:  # safety stop
                break
        return

    params = [(k, v) for k, v in filters.items()]
    params += [("page", str(state["page"])), ("size", str(state["size"]))]
    body = run_curl_get("/query", params)
    sys.stdout.write(_jq_compact(".data[]", body))


def cmd_rnd(filters: dict, positional: list[str], state: dict) -> None:
    countries = ",".join(positional) if positional else ""
    f = dict(filters)
    if countries:
        f["country_contains"] = countries
    if state["nc"]:
        f["country_not_contains"] = state["nc"]
    body = run_curl_get("/rnd", list(f.items()))
    sys.stdout.write(_jq_compact(".data", body))


def cmd_count(filters: dict, positional: list[str], state: dict) -> None:
    countries = ",".join(positional) if positional else ""
    f = dict(filters)
    if countries:
        f["country_contains"] = countries
    if state["nc"]:
        f["country_not_contains"] = state["nc"]
    params = list(f.items()) + [("page", str(state["page"])),
                                 ("size", str(state["size"]))]
    body = run_curl_get("/query", params)
    total = _jq(".total // 0", body).strip()
    print(total)


def cmd_convenience(key: str, filters: dict, positional: list[str], state: dict) -> None:
    """asn / ip / hn / hx — if filter not set, take first positional as value."""
    if positional and key not in filters:
        # The filter names in the API are ip_contains / asn_org_contains etc.
        api_key = {
            "asn": "asn_org_contains",
            "ip": "ip_contains",
            "hn": "host_name_contains",
            "hx": "host_name_not_contains",
        }[key]
        filters = {**filters, api_key: positional[0]}
    if state["nc"]:
        filters = {**filters, "country_not_contains": state["nc"]}
    params = list(filters.items()) + [("page", str(state["page"])),
                                      ("size", str(state["size"]))]
    body = run_curl_get("/query", params)
    sys.stdout.write(_jq_compact(".data[]", body))


def cmd_iso(state: dict) -> None:
    iv = -1 if state["iso_all"] else 1
    body = run_curl_get("/iso", [("is_valid", str(iv))])
    sys.stdout.write(_jq_compact(".data[]", body))


def cmd_post() -> None:
    body = sys.stdin.read()
    out = run_curl_post("/query", body)
    sys.stdout.write(out)


def cmd_jq() -> None:
    text = sys.stdin.read()
    sys.stdout.write(_jq(r'"\(.ip):\(.port)"', text))


def cmd_version() -> None:
    out = _curl(["curl", "-4sL", f"{API_BASE}/"])
    print(out, end="")


# ----------------------- main -----------------------

def main(argv: list[str]) -> int:
    # -h/--help works no matter how the script is invoked.
    if argv and argv[0] in ("-h", "--help", "help"):
        print(BANNER, end="")
        return 0

    # If invoked through a recognised alias basename (e.g. `vgget`), use
    # that alias's subcommand and treat the rest of argv as its args.
    prog = os.path.basename(sys.argv[0] or "vg")
    if prog in ALIAS_BASENAMES:
        cmd = ALIAS_BASENAMES[prog]
        rest = argv
    elif prog in CANONICAL_BASENAMES:
        # Reject unknown `vg*` basenames loudly (catches typos like
        # `vgge` or stray `vgfoo` symlinks).
        if prog != "vg" and prog != "vg.py":
            die(f"unknown alias: {prog} (allowed: {', '.join(sorted(ALIAS_BASENAMES))})")
        if argv and argv[0] in SUBCOMMANDS:
            cmd = argv[0]
            rest = argv[1:]
        elif not argv:
            # No subcommand at all — show help instead of silently defaulting.
            print(BANNER, end="")
            return 0
        else:
            die(
                f"unknown subcommand: {argv[0]!r} "
                f"(try: vg help; or create a symlink like `vgget`, `vgone`, "
                f"`vgc`, `vgiso`, `vgjq`, `vgv` to call without the "
                f"subcommand keyword)"
            )
    else:
        # Unrecognised basename that isn't a canonical `vg` invocation
        # (e.g. `python3 vg ...` from some other path) — still allow
        # explicit subcommand parsing as before.
        if argv and argv[0] in SUBCOMMANDS:
            cmd = argv[0]
            rest = argv[1:]
        else:
            die(
                f"unknown invocation name: {prog!r} "
                f"(use `vg <subcommand> ...` or a symlink named one of: "
                f"{', '.join(sorted(ALIAS_BASENAMES))})"
            )

    if cmd == "help":
        print(BANNER, end="")
        return 0

    if cmd == "v" or cmd == "version":
        cmd_version()
        return 0

    if cmd == "post":
        cmd_post()
        return 0

    if cmd == "jq":
        cmd_jq()
        return 0

    if cmd == "iso":
        filters, positional, state = parse_filter_args_full(rest)
        cmd_iso(state)
        return 0

    if cmd in ("c", "count"):
        filters, positional, state = parse_filter_args_full(rest)
        cmd_count(filters, positional, state)
        return 0

    if cmd in ("asn", "ip", "hn", "hx"):
        filters, positional, state = parse_filter_args_full(rest)
        cmd_convenience(cmd, filters, positional, state)
        return 0

    if cmd == "one":
        filters, positional, state = parse_filter_args_full(rest)
        cmd_rnd(filters, positional, state)
        return 0

    if cmd == "get":
        filters, positional, state = parse_filter_args_full(rest)
        cmd_query(filters, positional, state)
        return 0

    die(f"unknown subcommand: {cmd} (try: vg help)")
    return 2  # unreachable


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
