<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <SelfContained>false</SelfContained>
        <PublishAot>false</PublishAot>
        <RootNamespace>Duyao.VpnList</RootNamespace>
    </PropertyGroup>
    <PropertyGroup>
        <!-- 固定的主版本和次版本 -->
        <VersionMajor>1</VersionMajor>
        <VersionMinor>$([MSBuild]::Subtract($([System.DateTime]::Now.Year), 2000))</VersionMinor>
        <!-- 动态生成基于日期的 Build 和 Revision -->
        <VersionBuild>$([System.DateTime]::Now.ToString("MMdd"))</VersionBuild>
        <VersionRevision>$([System.DateTime]::Now.ToString("HHmm"))</VersionRevision>
        <!-- 组装完整版本号 -->
        <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</AssemblyVersion>
        <FileVersion>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</FileVersion>
        <InformationalVersion>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.12"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <!-- 显式提供 SQLite 原生库，规避 SqliteConnection type initializer 抛错 -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Duyao.ApiBase\Duyao.ApiBase.csproj"/>
    </ItemGroup>

    <!-- 内嵌 UI 资源（由 VpnController.Ui 读取） -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\vpn-ui.html" />
        <EmbeddedResource Include="Resources\favicon.png" />
    </ItemGroup>

    <!-- 确保 SQLite native 库 (runtimes/linux-*/native/libe_sqlite3.so) 一定被打入 publish 输出目录 -->
    <Target Name="CopySqliteNative" AfterTargets="Build;Publish">
        <ItemGroup>
            <_SqliteNative Include="$(NuGetPackageRoot)sqlitepclraw.bundle_e_sqlite3\2.1.10\runtimes\**\native\*e_sqlite3*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_SqliteNative)"
              DestinationFolder="$(OutDir)runtimes\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="'@(_SqliteNative)' != ''"/>
    </Target>

    <!-- publish 时排除 _scripts 目录 -->
    <ItemGroup>
        <Content Update="_scripts\**" CopyToPublishDirectory="Never" />
    </ItemGroup>


</Project>
